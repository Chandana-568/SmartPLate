{
  "name": "shareplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulators --port 5174",
    "emulators": "firebase emulators:start --project demo-shareplate",
    "test:e2e": "firebase emulators:exec --project demo-shareplate \"node tests/e2e-flow.ts\"",
    "test:whatsapp": "firebase emulators:exec --project demo-shareplate \"node tests/whatsapp-flow.ts\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
