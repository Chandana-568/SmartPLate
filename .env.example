# Copy this file to .env.local (git-ignored) and fill in ONE of the keys.
# These are read by the server only, never sent to the browser.

# Option 1 (free): Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.8-flash

# Option 2 (paid): https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# If both keys are set, force one: gemini | claude
# AI_PROVIDER=gemini
