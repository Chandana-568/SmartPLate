rules_version = '2';

// Deploy: Firebase console → Firestore Database → Rules → paste → Publish
//    or:  npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasRole(r) {
      return signedIn() && exists(userPath()) && get(userPath()).data.role == r;
    }

    // Keep in sync with ADMIN_EMAILS in src/context/AuthContext.tsx
    function isAdmin() {
      return hasRole('admin')
        || (signedIn() && request.auth.token.email == 'chandana66266@gmail.com');
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      allow read: if signedIn();

      // You can create only your own profile, and never as admin
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['donor', 'ngo', 'volunteer', 'recycler'];

      // You can edit your own profile but not change your role
      allow update: if (signedIn()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- donations/{id} ----------
    match /donations/{donationId} {
      // Anyone can browse food, even logged out
      allow read: if true;

      // Donors post food in their own name. AI-flagged posts (risk 70+)
      // must start hidden as "under_review" until an admin approves them.
      // Admins may create any donation (used by "Load demo data")
      allow create: if isAdmin() || (hasRole('donor')
        && request.resource.data.donorId == request.auth.uid
        && (request.resource.data.status == 'under_review'
            || (request.resource.data.status == 'available'
                && request.resource.data.get('riskScore', 0) < 70)));

      function otpPath() {
        return /databases/$(database)/documents/donations/$(donationId)/private/otp;
      }

      // Donations made before pickup codes existed have no otp doc
      function pickupCodeMatches() {
        return !exists(otpPath())
          || request.resource.data.pickupOtp == get(otpPath()).data.code;
      }

      function assignedVolunteer() {
        return resource.data.get('volunteerId', null);
      }

      // Pickup timer (max 5 h). Old listings without expiresAt never expire here.
      function notExpired() {
        return resource.data.get('expiresAt', null) == null
          || request.time.toMillis() < resource.data.expiresAt;
      }

      function expiredForPeople() {
        return resource.data.get('expiresAt', null) is number
          && request.time.toMillis() >= resource.data.expiresAt
          && resource.data.status in ['available', 'claimed'];
      }

      allow update: if isAdmin()

        // Donor edits details; delivery fields are off limits
        || (signedIn()
            && resource.data.donorId == request.auth.uid
            && request.resource.data.status == resource.data.status
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'donorId', 'rescuedBy', 'rescuedByName', 'volunteerId',
                 'volunteerName', 'pickupOtp', 'claimedAt', 'assignedAt',
                 'pickedUpAt', 'deliveredAt', 'completedAt', 'riskScore', 'riskReasons',
                 'aiAnalysis', 'imageHash', 'reviewedBy', 'reviewedAt',
                 'recycle', 'expiresAt', 'volunteerRequested',
                 'volunteerRequestedAt', 'volunteerNote']))

        // NGO claims available food for itself
        || (hasRole('ngo')
            && notExpired()
            && resource.data.status == 'available'
            && request.resource.data.status == 'claimed'
            && request.resource.data.rescuedBy == request.auth.uid
            && changedOnly(['status', 'rescuedBy', 'rescuedByName', 'claimedAt',
                            'volunteerRequested', 'volunteerRequestedAt']))

        // The claiming NGO asks for (or cancels) a volunteer while nobody has taken it
        || (signedIn()
            && notExpired()
            && resource.data.rescuedBy == request.auth.uid
            && resource.data.status == 'claimed'
            && assignedVolunteer() == null
            && changedOnly(['volunteerRequested', 'volunteerRequestedAt', 'volunteerNote']))

        // The claiming NGO can't collect it at all: release it to other NGOs
        || (signedIn()
            && notExpired()
            && resource.data.rescuedBy == request.auth.uid
            && resource.data.status == 'claimed'
            && assignedVolunteer() == null
            && request.resource.data.status == 'available'
            && request.resource.data.rescuedBy == null
            && changedOnly(['status', 'rescuedBy', 'rescuedByName', 'claimedAt',
                            'volunteerRequested', 'volunteerRequestedAt', 'volunteerNote']))

        // Volunteer accepts a claimed task nobody has taken yet
        || (hasRole('volunteer')
            && notExpired()
            && resource.data.status == 'claimed'
            && assignedVolunteer() == null
            && resource.data.get('volunteerRequested', true) != false
            && request.resource.data.volunteerId == request.auth.uid
            && changedOnly(['volunteerId', 'volunteerName', 'assignedAt']))

        // Assigned volunteer (or the NGO collecting it itself) picks it up
        // with the donor's correct 4-digit code
        || (signedIn()
            && notExpired()
            && resource.data.status == 'claimed'
            && request.resource.data.status == 'picked-up'
            && request.resource.data.volunteerId == request.auth.uid
            && (assignedVolunteer() == request.auth.uid
                || (resource.data.rescuedBy == request.auth.uid
                    && assignedVolunteer() == null))
            && pickupCodeMatches()
            && changedOnly(['status', 'volunteerId', 'volunteerName',
                            'pickupOtp', 'pickedUpAt']))

        // Volunteer says it's delivered (status stays picked-up)
        || (signedIn()
            && resource.data.volunteerId == request.auth.uid
            && resource.data.status == 'picked-up'
            && request.resource.data.status == 'picked-up'
            && changedOnly(['deliveredAt']))

        // Only the receiving NGO confirms it got the food
        || (signedIn()
            && resource.data.rescuedBy == request.auth.uid
            && resource.data.status == 'picked-up'
            && request.resource.data.status == 'completed'
            && changedOnly(['status', 'completedAt']))

        // Poultry farm / compost / biogas unit claims expired food nobody took
        || (hasRole('recycler')
            && expiredForPeople()
            && resource.data.get('recycle', null) == null
            && request.resource.data.recycle.byId == request.auth.uid
            && request.resource.data.recycle.status == 'claimed'
            && request.resource.data.recycle.type in ['poultry', 'compost', 'biogas']
            && changedOnly(['recycle']))

        // ...and marks it collected
        || (hasRole('recycler')
            && resource.data.get('recycle', null) != null
            && resource.data.recycle.byId == request.auth.uid
            && resource.data.recycle.status == 'claimed'
            && request.resource.data.recycle.byId == request.auth.uid
            && request.resource.data.recycle.type == resource.data.recycle.type
            && request.resource.data.recycle.status == 'collected'
            && changedOnly(['recycle']));

      // Donors can cancel only food nobody has claimed or is recycling
      allow delete: if isAdmin()
        || (signedIn()
            && resource.data.donorId == request.auth.uid
            && resource.data.status in ['available', 'under_review']
            && resource.data.get('recycle', null) == null);

      // ---------- donations/{id}/private/otp (pickup code) ----------
      match /private/{docId} {
        function parentPath() {
          return /databases/$(database)/documents/donations/$(donationId);
        }

        allow read: if isAdmin()
          || (signedIn() && get(parentPath()).data.donorId == request.auth.uid);

        // Created in the same batch as the donation, so check the result
        allow create: if signedIn()
          && getAfter(parentPath()).data.donorId == request.auth.uid
          && request.resource.data.code is string;

        allow delete: if isAdmin()
          || (signedIn() && get(parentPath()).data.donorId == request.auth.uid);
      }
    }
  }
}
